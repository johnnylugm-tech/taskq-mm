# taskq-api environment variables — all 12 TASKQ_* must be declared here (SPEC §5.1, §8 #26).
# Copy to .env for local development. Production must override TASKQ_DB_URL.

# Database connection string (NFR-04: never logged)
TASKQ_DB_URL=sqlite:///./taskq.db
# Connection pool size (FR-06)
TASKQ_DB_POOL_SIZE=5
# Per-task subprocess timeout in seconds (FR-08)
TASKQ_TASK_TIMEOUT=10.0
# Background runner concurrency cap (FR-08)
TASKQ_MAX_CONCURRENT=8
# Graceful drain budget on shutdown, in seconds (FR-08)
TASKQ_DRAIN_TIMEOUT=30.0
# Token bucket burst capacity (FR-05)
TASKQ_RATE_BURST=20
# Token refill rate, tokens per second (FR-05)
TASKQ_RATE_PER_SEC=5.0
# CORS allowlist (comma-separated); empty means deny all origins (NFR-02)
TASKQ_CORS_ORIGINS=
# Log level: DEBUG / INFO / WARNING / ERROR
TASKQ_LOG_LEVEL=INFO
# Log format: json / text
TASKQ_LOG_FORMAT=json
# Bind address (default: loopback only)
TASKQ_HOST=127.0.0.1
# Bind port
TASKQ_PORT=8000